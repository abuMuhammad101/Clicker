# Copy to .env and fill in. Never commit .env.
# The real values live in a password manager, not in this repo.

# Neon Postgres connection string.
# Neon dashboard > your project > Connection Details > pooled connection.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/clicker?sslmode=require

# Django. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API with the session cookie, and to submit
# CSRF-protected writes. Defaults to the Vite dev server; only set these
# when the frontend runs elsewhere.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8000/api

# Optional: a local, non-staff account for automated verification of the
# logged-in path. Create it per machine; never reuse a real person's login.
# DEV_TEST_USERNAME=
# DEV_TEST_PASSWORD=
