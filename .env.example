# Copy to .env and fill in. Never commit .env.
# The real values live in a password manager, not in this repo.

# Neon Postgres connection string.
# Neon dashboard > your project > Connection Details > pooled connection.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/clicker?sslmode=require

# Optional: a local Postgres for `manage.py test` only (see README, "Fast
# tests"). The app never reads it. Unset, tests run against Neon (slow).
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres

# Django. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# development (default) or production. Production switches on HTTPS redirect,
# HSTS, the proxy SSL header and secure cookies, and refuses to start with
# DEBUG on or ALLOWED_HOSTS empty. It is NOT tied to DEBUG.
# Production uses its own DATABASE_URL and SECRET_KEY, never these.
# CLICKER_ENV=development
# Reverse proxies in front of the app in production (Render: 1). 0 here.
# CLICKER_TRUSTED_PROXY_COUNT=0
# Hard session limit in seconds from sign-in, on top of the 12-hour idle
# timeout. Default 24 hours.
# CLICKER_SESSION_MAX_AGE=86400
# Production email (SMTP over TLS). Unused in development.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Origins allowed to call the API with the session cookie, and to submit
# CSRF-protected writes. Defaults to the Vite dev server; only set these
# when the frontend runs elsewhere.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8000/api

# Optional: a local, non-staff account for automated verification of the
# logged-in path. Create it per machine; never reuse a real person's login.
# DEV_TEST_USERNAME=
# DEV_TEST_PASSWORD=

# Optional: a local test user in the Clerk role, created by
# `manage.py seed_roles`. Per machine, never committed, never a real person.
# DEV_CLERK_USERNAME=
# DEV_CLERK_PASSWORD=
